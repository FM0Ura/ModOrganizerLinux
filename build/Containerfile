# Build environment for the native Linux port of Mod Organizer 2.
# This file is the single source of the package list used by CI and by local
# container builds (podman/docker/distrobox). See README.md.
#   podman build -t mo2-linux-build -f build/Containerfile build/
FROM fedora:44

RUN dnf -y install --setopt=install_weak_deps=False \
        gcc gcc-c++ make cmake ninja-build pkgconf-pkg-config \
        git curl ca-certificates python3 python3-devel \
        qt6-qtbase-devel qt6-qtbase-private-devel \
        qt6-qtwebengine-devel qt6-qtwebsockets-devel qt6-qtnetworkauth-devel \
        qt6-qtdeclarative-devel qt6-qttools-devel qt6-qtwayland \
        boost-devel spdlog-devel fmt-devel lz4-devel zlib-devel \
        gtest-devel fuse3 fuse3-devel clang-tools-extra \
        libsecret-devel gnome-keyring dbus-daemon tomlplusplus-devel libcurl-devel \
    && dnf clean all

# Rust (stable) via rustup, system-wide so any user in a distrobox sees it.
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain stable \
    && /opt/cargo/bin/rustup component add rustfmt clippy \
    && chmod -R a+rX /opt/rustup /opt/cargo

# No QT_QPA_PLATFORM here: the image is also used as a distrobox to run the application
# on a desktop. build.sh --tests and the smoke test set QT_QPA_PLATFORM=offscreen themselves.

WORKDIR /src
