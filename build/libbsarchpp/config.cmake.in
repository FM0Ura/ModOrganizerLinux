# Package config of libbsarchpp, used by build/libbsarchpp/build-libbsarchpp.sh in
# place of upstream's cmake/config.cmake.in (1.0.7), which calls find_dependency
# without including CMakeFindDependencyMacro and defines lz4::lz4 even when another
# package (mo2-bsatk, through build/lz4/lz4Config.cmake) already did.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(ZLIB REQUIRED)

if (WIN32)
    find_dependency(lz4 REQUIRED)
else()
    find_dependency(TBB REQUIRED)
    if (NOT TARGET lz4::lz4)
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(lz4 REQUIRED IMPORTED_TARGET liblz4)
        add_library(lz4::lz4 ALIAS PkgConfig::lz4)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libbsarchpp-targets.cmake")
